# Lisa Share: convert in both directions.  Copy "A Long Text.txt" (row 0) from the server as
# a LisaWrite document (Edit > Copy as LisaWrite, then Paste in the
# diskette's window); then copy that document back to the server as text
# (Copy Reference, then Edit > Paste as Text in the browser).  The new
# document is the fourth icon in the diskette's window, at (430, 60).
# Positions as in roundtrip.script; the tool's Edit menu: Copy 23, Copy as
# LisaWrite 38, Paste 68, Paste as Text 83.
def menu(x, y) {
  machine.adb.mouse.move $x 7 "global"
  scheduler.run 2000000
  machine.adb.mouse.click true
  scheduler.run 3000000
  machine.adb.mouse.move $x $y "global"
  scheduler.run 3000000
  machine.adb.mouse.click false
  scheduler.run 3000000
}
menu(230, 23)
scheduler.run 60000000
click(100, 60)
scheduler.run 5000000
menu(230, 38)
scheduler.run 60000000
click(100, 60)
scheduler.run 5000000
menu(230, 38)
scheduler.run 60000000
# Hello.txt: Edit > Copy as LisaWrite; set aside; paste in the diskette's window
click(100, 60)
scheduler.run 5000000
menu(168, 38)
scheduler.run 20000000
menu(95, 38)
scheduler.run 60000000
click(400, 200)
scheduler.run 20000000
menu(168, 98)
scheduler.run 150000000
# the new LisaWrite document: Copy Reference; reopen the browser; Paste as Text
click(310, 60)
scheduler.run 20000000
menu(168, 83)
scheduler.run 20000000
dclick(58, 338)
scheduler.run 100000000
menu(168, 83)
scheduler.run 150000000
